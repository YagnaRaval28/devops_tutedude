<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Success | Docker Assignment</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="nav">
    <a class="brand" href="/">Docker Assignment</a>
    <div class="links">
      <a href="/">Form</a>
      <a href="/submissions">Submissions</a>
      <a href="/health">Health</a>
    </div>
  </nav>

  <main class="container">
    <div class="success-box">
      <div class="tick">&#10004;</div>
      <h1><%= message %></h1>
      <p>The Flask backend received and processed your submission.</p>

      <table class="table">
        <tbody>
          <tr><th>Name</th><td><%= result.name %></td></tr>
          <tr><th>Email</th><td><%= result.email %></td></tr>
          <tr><th>Phone</th><td><%= result.phone || '-' %></td></tr>
          <tr><th>Course</th><td><%= result.course %></td></tr>
          <tr><th>Message</th><td><%= result.message || '-' %></td></tr>
          <tr><th>Submitted at</th><td><%= result.submitted_at %></td></tr>
        </tbody>
      </table>

      <div class="actions">
        <a class="btn" href="/">Submit another</a>
        <a class="btn btn-primary" href="/submissions">View all submissions</a>
      </div>
    </div>
  </main>

  <footer class="footer">DevOps Assignment &mdash; Docker &amp; Docker Compose</footer>
</body>
</html>
