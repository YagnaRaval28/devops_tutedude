<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registration | Docker Assignment</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="nav">
    <a class="brand" href="/">Docker Assignment</a>
    <div class="links">
      <a href="/">Form</a>
      <a href="/submissions">Submissions</a>
      <a href="/health">Health</a>
    </div>
  </nav>

  <main class="container">
    <h1>Registration Form</h1>
    <p class="lead">
      Served by the <strong>Express frontend</strong>, processed by the
      <strong>Flask backend</strong>, connected over a Docker network.
    </p>

    <% if (error) { %>
    <div class="alert alert-error"><strong>Error:</strong> <%= error %></div>
    <% } %>

    <form class="form" method="POST" action="/submit" novalidate>
      <label for="name">Full Name <span class="req">*</span></label>
      <input type="text" id="name" name="name" value="<%= data.name || '' %>"
             placeholder="Enter your full name">

      <label for="email">Email <span class="req">*</span></label>
      <input type="text" id="email" name="email" value="<%= data.email || '' %>"
             placeholder="you@example.com">

      <label for="phone">Phone <span class="hint">(10 digits, optional)</span></label>
      <input type="text" id="phone" name="phone" value="<%= data.phone || '' %>"
             placeholder="9876543210">

      <label for="course">Course <span class="req">*</span></label>
      <select id="course" name="course">
        <option value="">-- Select a course --</option>
        <% courses.forEach(function (c) { %>
        <option value="<%= c %>" <%= data.course === c ? 'selected' : '' %>><%= c %></option>
        <% }); %>
      </select>

      <label for="message">Message <span class="hint">(optional)</span></label>
      <textarea id="message" name="message" rows="4"
                placeholder="Anything you want to add"><%= data.message || '' %></textarea>

      <button class="btn btn-primary" type="submit">Submit</button>
    </form>

    <p class="muted">Backend: <code><%= backendUrl %></code></p>
  </main>

  <footer class="footer">DevOps Assignment &mdash; Docker &amp; Docker Compose</footer>
</body>
</html>
