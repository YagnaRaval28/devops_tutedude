# ---- MongoDB Atlas ----
# Get this from Atlas -> Cluster -> Connect -> Drivers -> Python
# Remember to URL-encode special characters in your password.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB=tutedude_assignment
MONGO_COLLECTION=registrations

# ---- Flask ----
SECRET_KEY=change-this-to-a-long-random-string
FLASK_DEBUG=1
